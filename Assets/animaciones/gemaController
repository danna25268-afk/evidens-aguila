using UnityEngine;

public class GemaController : MonoBehaviour
{
    [Header("Configuración de Rotación")]
    // Velocidad de rotación en los ejes (puedes ajustarla desde el Inspector)
    public Vector3 velocidadRotacion = new Vector3(0f, 100f, 0f);

    [Header("Configuración de Colisión")]
    // Etiqueta (Tag) del objeto que destruirá la gema (por ejemplo, "Aguila" o "Player")
    public string tagDelAguila = "Aguila";

    void Update()
    {
        // Hace girar la gema continuamente en su propio eje local
        transform.Rotate(velocidadRotacion * Time.deltaTime, Space.Self);
    }

    private void OnTriggerEnter(Collider other)
    {
        // Verifica si el objeto que entró en contacto tiene el Tag del águila
        if (other.CompareTag(tagDelAguila))
        {
            // Destruye el GameObject de la gema
            Destroy(gameObject);
        }
    }

    // Nota: Si tu juego es 2D, usa OnTriggerEnter2D en lugar de OnTriggerEnter:
    /*
    private void OnTriggerEnter2D(Collider2D other)
    {
        if (other.CompareTag(tagDelAguila))
        {
            Destroy(gameObject);
        }
    }
    */
}